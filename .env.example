# ─────────────────────────────────────────────────────────────
# SEVOURA — environment variables
# Copy to .env.local for local development. On Vercel, add these in
# Project → Settings → Environment Variables. Never commit real values.
# ─────────────────────────────────────────────────────────────

# REQUIRED — Supabase project (Supabase → Project Settings → API)
# Public by design: protected by Row Level Security.
# (SEVOURA_-prefixed names win over the generic ones a Vercel Supabase integration may add)
NEXT_PUBLIC_SEVOURA_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SEVOURA_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# RECOMMENDED — your live site URL (used for SEO metadata)
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# ── Razorpay payments (SERVER-ONLY secrets — no NEXT_PUBLIC_ prefix, never sent to the browser) ──
# Supabase → Project Settings → API Keys → secret / service_role key
SEVOURA_SUPABASE_SERVICE_ROLE_KEY=
# Razorpay Dashboard → (Test mode) → Account & Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard → Webhooks → the secret you type when creating the webhook
RAZORPAY_WEBHOOK_SECRET=
# Live keys (rzp_live_…) are refused unless this is "true". Set it only when the owner approves going live.
RAZORPAY_ALLOW_LIVE=false
