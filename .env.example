# ─────────────────────────────────────────────────────────────
# SEVOURA — environment variables
# Copy to .env.local for local development. On Vercel, add these in
# Project → Settings → Environment Variables. Never commit real values.
# ─────────────────────────────────────────────────────────────

# REQUIRED — Supabase project (Supabase → Project Settings → API)
# Public by design: protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# RECOMMENDED — your live site URL (used for SEO metadata)
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# ── Only needed later, when Razorpay is integrated ──
# SERVER-ONLY secrets (no NEXT_PUBLIC_ prefix — never sent to the browser)
SUPABASE_SERVICE_ROLE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Public Razorpay key id + switch that turns on the payment step at checkout
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_PAYMENTS_ENABLED=false
